N'), 'BROKEN', 'DOWN', 'DISABLED', 'DOWN', 'UP') END) BROKEN,  DB.JOB_NAME,  DB.LAST_RUN_DURATION, IS_JOB_MODIFIABLE,  CASE WHEN UPPER(REP.DBMS_JOBNAME)='EM_TASK.WORKER' THEN 'EMD_COLLECTION' WHEN UPPER(REP.DBMS_JOBNAME)='EM_JOB_OBSERVER.RUN_CYCLE' THEN 'EM_JOB_STEP_SCHEDULER' ELSE R.JOB_DISPLAY_NAME_NLSID END JOB_DISPLAY_NLSID, DB.STATE,  CASE WHEN UPPER(REP.DBMS_JOBNAME)='EM_TASK.WORKER' THEN DECODE(REP.TASK_CLASS_LIST, '0', 'SHORT_RUNNING', 'LONG_RUNNING') ELSE 'NONE' END TASK_CLASS_LIST FROM (SELECT DISTINCT P.DISPLAY_NAME,  P.JOB_NAME,  P.DBMS_JOBNAME,  CASE WHEN UPPER(P.DBMS_JOBNAME)='EM_TASK.WORKER' THEN UPPER(P.DBMS_JOBNAME)||'('||W.WORKER_ID||')' WHEN UPPER(P.DBMS_JOBNAME)='EM_JOB_OBSERVER.RUN_CYCLE' THEN UPPER(P.JOB_NAME) ELSE RTRIM(UPPER(P.DBMS_JOBNAME), ';') END WHAT,  CASE WHEN P.DBMS_JOBNAME='EM_TASK.WORKER' THEN W.WORKER_ID ELSE 0 END WORKER_ID,  IS_JOB_MODIFIABLE,  CASE WHEN P.DBMS_JOBNAME='EM_TASK.WORKER' THEN W.TASK_CLASS_LIST ELSE '0' END TASK_CLASS_LIST FROM MGMT_PE
RFORMANCE_NAMES P,  (SELECT WORKER_ID, TASK_CLASS_LIST FROM MGMT_COLLECTION_WORKERS WHERE WORKER_STATUS != 2 UNION SELECT NVL(MAX(WORKER_ID), 0) WORKER_ID,  B.TCL TASK_CLASS_LIST FROM MGMT_COLLECTION_WORKERS A,  (SELECT '0' AS TCL FROM DUAL UNION ALL SELECT '1' AS TCL FROM DUAL) B WHERE 2 != WORKER_STATUS(+) AND B.TCL = A.TASK_CLASS_LIST(+) GROUP BY B.TCL) W WHERE P.IS_DBMSJOB = 'Y' AND P.JOB_NAME NOT IN ( SELECT JOB_NAME FROM USER_SCHEDULER_JOBS WHERE SCHEDULE_TYPE = 'ONCE' AND STATE = 'SUCCEEDED' ) ) REP,  EM_SCHED_JOB_REGISTRY R,  (SELECT STATE,  NEXT_RUN_DATE,  LAST_START_DATE,  JOB_NAME,  LAST_RUN_DURATION ,  CASE WHEN UPPER(JOB_ACTION)='EM_JOB_OBSERVER.RUN_CYCLE' THEN UPPER(JOB_NAME) ELSE RTRIM(UPPER(JOB_ACTION), ';') END WHAT FROM USER_SCHEDULER_JOBS J ) DB WHERE REP.WHAT = DB.WHAT (+) AND R.JOB_NAME(+) = REP.JOB_NAME ORDER BY WHAT,  CLIENT_DATA</pre_sqltext></td></tr>
